{
  "name": "beatsync",
  "version": "1.0.5",
  "description": "a tool that backs up Beat screenplay documents to the cloud",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "release": "node scripts/release.js",
    "release:ci": "node scripts/release.js --yes"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "chokidar": "^3.6.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.beatsync.app",
    "productName": "beatsync",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "assets/logo.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/logo.png"
    }
  }
}
